<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:leaf="clr-namespace:Leaf;assembly=Leaf" Title="Leaf" Width="456" Height="620" MinWidth="360" MinHeight="380" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" ShowActivated="False" Topmost="True">
  <Window.Resources>
    <!-- The reading page reuses the editor's plain text engine: a borderless, top-aligned
         TextBox whose scrollbars stay inside its own template binding. -->
    <Style x:Key="PaperReader" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsUndoEnabled" Value="False"/>
      <Setter Property="SelectionBrush" Value="#BACCDD"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" Background="Transparent"
                          BorderThickness="0" Padding="0" Focusable="False"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Paper top-bar icons drawn as strokes: settings is two slider rows — a knob opening
         left on the upper row, right on the lower — beside the pushpin and the collapse bar.
         Every one of them is authored inside the same 24-unit square and centred on it, so
         the three share one drawing scale: each glyph is drawn through a canvas of that same
         square inside its own viewbox, and none of them is stretched to fill its box. -->
    <Geometry x:Key="SlidersIcon">M8,7.2 H20 M4,16.8 H14.8 M5.4,7.2 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M17.4,16.8 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0</Geometry>
    <!-- The pin reads as a pushpin: a wide rounded head that tapers inward to a narrow
         base, with the thin needle below. -->
    <Geometry x:Key="PinIcon">M12,14 V21 M9.1,3.5 H14.9 C16.9,3.5 18.2,4.9 17.9,6.7 C17.7,8.2 17,9.4 16,10.4 C15.2,11.2 14.8,12.1 14.7,13.1 L14.6,14.5 H9.4 L9.3,13.1 C9.2,12.1 8.8,11.2 8,10.4 C7,9.4 6.3,8.2 6.1,6.7 C5.8,4.9 7.1,3.5 9.1,3.5 Z</Geometry>
    <Geometry x:Key="HideIcon">M4,12 H20</Geometry>
    <!-- The three top-bar entries share one 32-dip square: plain by default with a dark
         glyph and a neutral hover, and the active twin paints the dark chip with a white
         glyph only while its own state is really on (settings page open, window pinned). -->
    <Style x:Key="PaperTopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Soft}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PaperTopButtonActive" TargetType="Button" BasedOn="{StaticResource PaperTopButton}">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Ink}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <!-- The halo and the paper are two layers of one stack: the border below paints only the
       drop shadow and takes no mouse, and the surface above it carries every control. No
       text is ever rendered inside an Effect subtree, because an ancestor effect draws its
       subtree through an intermediate surface, which is one way glyphs go soft. That opaque
       surface is also the boundary where ClearType is asked for - ClearTypeHint plus an
       explicit Display/ClearType request are the settings WPF documents for it, and WPF
       still decides what the window's own transparency allows, so this is a layout
       correction and not a proven cure for the blur. -->
  <Grid>
    <Border Margin="8" Background="White" CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect Color="#142334" BlurRadius="22" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
    </Border>
    <Border Margin="8" Background="White" CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1"
            UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled"
            TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
      <Grid x:Name="PopupContent" Margin="26,12,26,24">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="DragBar" Grid.Row="0" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- The source badge is the reading page's auxiliary tier, so it stays at the
                 label size that never shrinks with the window. It carries no negative margin
                 and no compensating head start: it sits on this bar's own left edge, and the
                 reading column below is inset from that edge by whatever its document hosts
                 measure (see AlignReadingColumn), which is what leaves the badge slightly to
                 the left of the reading text without any text leaving its layout. -->
            <TextBlock x:Name="SourceBadge" Text="剪贴板" FontSize="14" Foreground="{StaticResource Secondary}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SettingsButton" Style="{StaticResource PaperTopButton}" ToolTip="设置" AutomationProperties.Name="设置">
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource SlidersIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource PaperTopButton}" Margin="8,0,0,0" ToolTip="置顶并保持显示" AutomationProperties.Name="置顶或取消置顶">
              <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource PinIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="HideButton" Style="{StaticResource PaperTopButton}" Margin="8,0,0,0" ToolTip="收起" AutomationProperties.Name="收起浮窗">
              <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource HideIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>
        <Grid x:Name="TranslatePage" Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <!-- The label and the original sit four dips lower than the translation and the
               card rule below them without moving those: only this panel's own padding moves,
               so its total height - and everything under it - stays exactly where it was. That
               padding is read from the window's own scale (14 + 10 per step), and it is only
               ever a top inset: a compact window trims the inset instead of turning the panel's
               bottom padding negative, which is why the panel's height - and with it the
               translation and the card under it - is the same as it was. -->
          <Border x:Name="SourcePanel" Padding="0,24,0,0">
            <StackPanel>
              <!-- Every reading control starts on one column, and no control carries a
                   guessed head start towards it: the label, the original over its highlight,
                   the editor, the caption and the translation are all measured once against
                   the laid-out text itself (see AlignReadingColumn), and only that measured
                   difference moves any of them. The label is the column's own reference,
                   because a plain text block starts its glyphs at its own left edge. -->
              <Grid Margin="0,0,0,12">
                <StackPanel x:Name="SourceLabelRow" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="SourceLabel" Text="原文" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" TextAlignment="Left"/>
                  <Button x:Name="BackToPreviousButton" Content="返回上一会话" Style="{StaticResource GhostButton}" FontSize="13" Padding="7,3" Margin="9,0,0,0" Visibility="Collapsed" ToolTip="回到上一次翻译的内容与词卡" AutomationProperties.Name="返回上一会话"/>
                </StackPanel>
                <Button x:Name="EditSourceButton" Content="&#xE70F;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Height="24" Width="24" ToolTip="编辑原文" AutomationProperties.Name="编辑原文" FontSize="18"/>
              </Grid>
              <!-- The highlight is one background layer in the same cell, under the
                   transparent reading box: bands render behind the glyphs and are clipped
                   to this cell, instead of an adorner layer painting over the text. -->
              <Grid x:Name="SourceReading">
                <leaf:SourceHighlightLayer x:Name="SourceHighlight"/>
                <TextBox x:Name="SourceText" Style="{StaticResource PaperReader}"
                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" FontSize="18"
                         Foreground="{StaticResource Secondary}" VerticalScrollBarVisibility="Auto"
                         TextAlignment="Left"
                         AutomationProperties.Name="原文"/>
              </Grid>
              <Grid x:Name="SourceEditor" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SourceInput" Grid.Column="0" Style="{StaticResource PopupEditor}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="110"
                         FontSize="18" MaxLength="6000" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="原文"/>
                <TextBox x:Name="SourcePlaceholder" Grid.Column="0" Text="输入要翻译的文字…"
                         Style="{StaticResource PopupEditor}" IsReadOnly="True" Focusable="False"
                         IsTabStop="False" IsHitTestVisible="False" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="38" MaxHeight="110"
                         Foreground="{StaticResource Muted}"
                         Padding="{Binding Padding, ElementName=SourceInput}"
                         FontFamily="{Binding FontFamily, ElementName=SourceInput}"
                         FontSize="{Binding FontSize, ElementName=SourceInput}"
                         FontWeight="{Binding FontWeight, ElementName=SourceInput}"/>
                <Button x:Name="TranslateButton" Grid.Column="1" Margin="8,0,0,0"
                        Style="{StaticResource PopupActionButton}" VerticalAlignment="Top" Visibility="Collapsed"
                        ToolTip="翻译" AutomationProperties.Name="翻译原文">
                  <Viewbox Width="14" Height="14">
                    <Path Data="{StaticResource SubmitArrow}" Stroke="{StaticResource Ink}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Viewbox>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="BodyScroll" Style="{StaticResource SlimScrollViewer}" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock x:Name="TranslationCaption" Text="译文" Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,15" TextAlignment="Left"/>
              <RichTextBox x:Name="TranslationText" Style="{StaticResource ReadingText}" FontSize="19" Margin="0,0,8,16">
                <FlowDocument PagePadding="0" FontFamily="{StaticResource PaperFontFamily}" FontSize="19"/>
              </RichTextBox>
              <Grid x:Name="BusyPanel" Visibility="Collapsed" Margin="0,6,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="BusyLabel" Text="正在翻译…" FontSize="13" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="停止" Style="{StaticResource GhostButton}"/>
              </Grid>
              <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F8F0EB" CornerRadius="10" Padding="13" Margin="0,6,0,12">
                <StackPanel>
                  <TextBlock x:Name="ErrorText" Foreground="#935E43" FontSize="13" LineHeight="21"/>
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button x:Name="RetryButton" Content="重试" Style="{StaticResource GhostButton}" Foreground="#935E43"/>
                    <Button x:Name="SetupButton" Content="打开设置" Style="{StaticResource GhostButton}" Foreground="#935E43"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button x:Name="ExpandWordButton" Content="展开学习" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Visibility="Collapsed"/>
              <Border x:Name="WordPanel" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,17,0,0">
                <!-- The collapse action floats over the card's own top-right corner instead of
                     taking a line of its own above it, so the entry shares its row. It stays a
                     sibling of the document and never becomes part of it: only the card's first
                     paragraph reserves the button's column on the right (see DrawWordCard), so
                     the button can never cover the entry or any later line. -->
                <Grid>
                  <!-- The entry, the meaning, the part of speech and lemma, and every section
                       heading and body are paragraphs of this one read-only flow: a drag that
                       starts on a heading runs straight on into the content it belongs to. -->
                  <RichTextBox x:Name="WordCard" Style="{StaticResource ReadingText}" FontSize="16" AutomationProperties.Name="学习词卡">
                    <FlowDocument PagePadding="0" FontFamily="{StaticResource PaperFontFamily}" FontSize="16" TextAlignment="Left"/>
                  </RichTextBox>
                  <!-- The collapse entry shares the entry's first line at one step up from the
                       auxiliary 13 dip tier: the card's own first paragraph reserves the wider
                       WordCardActionColumn for it, so the larger label still cannot cover text. -->
                  <Button x:Name="BackToSentence" Content="收起释义" Style="{StaticResource GhostButton}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-4,0,0"/>
                </Grid>
              </Border>
              <Border x:Name="ChatPanel" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,17,0,4" Margin="0,17,0,0">
                <StackPanel x:Name="ChatMessages"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <!-- The follow-up entry is the reading page's own footer: the learning body ends
               further above it (the row's top margin) and it keeps more paper under itself
               (the row's bottom margin) than it did. Both margins belong to this row alone, so
               the settings page keeps its own spacing. They are the paper the entry sits on,
               not fixed furniture, so a shrinking window trims them like its other insets
               (see UpdatePopupTypography): the body above is the page's only scrolling region
               and it is what gets that paper back. -->
          <Grid x:Name="AskRow" Grid.Row="2" Margin="0,36,0,16">
            <!-- The button's content starts at its own left padding, so it is inset by exactly
                 that padding to put its icon's visible left edge - and nothing else - on the
                 shared reading column; the reading column measurement corrects that figure if
                 the laid-out text turns out to need a column of its own. -->
            <Button x:Name="AskButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" FontSize="16" Foreground="{StaticResource Ink}" Padding="8,7" Margin="-8,0,0,0" ToolTip="追问这段原文或当前词" AutomationProperties.Name="追问">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="21" Height="21" Margin="0,0,8,0" VerticalAlignment="Center">
                  <!-- A round follow-up bubble with its tail at the lower left, matching the
                       paper's rounded forms; the shared ChatOutline stays square-cornered.
                       The 21-unit canvas keeps the drawing at its authored scale. Account
                       for the half-stroke at the left edge and centre the visible outline
                       vertically, so no stroke extends beyond the canvas. -->
                  <Canvas Width="21" Height="21">
                    <Path Data="M12,3.5 C16.7,3.5 20.5,7 20.5,11.5 C20.5,16 16.7,19.5 12,19.5 C10.6,19.5 9.3,19.2 8.1,18.6 L3.5,20.5 L5.4,16.2 C4.2,14.9 3.5,13.3 3.5,11.5 C3.5,7 7.3,3.5 12,3.5 Z"
                          Stroke="{StaticResource Secondary}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round">
                      <Path.RenderTransform><TranslateTransform X="-2.75" Y="-1.5"/></Path.RenderTransform>
                    </Path>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="追问" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="CopyStatus" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </Grid>
          <Border x:Name="InputPanel" Grid.Row="3" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,12,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock x:Name="TopicLabel" Text="关于这段原文" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="CloseQuestionButton" Style="{StaticResource PopupActionButton}" HorizontalAlignment="Right" ToolTip="收起追问" AutomationProperties.Name="收起追问">
                  <Viewbox Width="12" Height="12">
                    <Path Data="{StaticResource FoldChevron}" Stroke="{StaticResource Secondary}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Viewbox>
                </Button>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionInput" AcceptsReturn="True" Height="66" MaxLength="1500" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8" AutomationProperties.Name="追问输入"/>
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PopupActionButton}" Margin="8,0,0,0" VerticalAlignment="Bottom" ToolTip="发送" AutomationProperties.Name="发送追问">
                  <Viewbox Width="14" Height="14">
                    <Path Data="{StaticResource SubmitArrow}" Stroke="{StaticResource Ink}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Viewbox>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,20,0,24">
            <TextBlock Text="翻译服务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="SettingsBackButton" Content="返回" Style="{StaticResource GhostButton}" FontSize="13" HorizontalAlignment="Right" ToolTip="返回翻译" AutomationProperties.Name="返回翻译"/>
          </Grid>
          <ContentControl x:Name="SettingsPageHost" Grid.Row="1"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
