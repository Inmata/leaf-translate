<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Leaf · 设置" Width="620" Height="780" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterScreen">
  <Grid Margin="32,26,32,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="按你的习惯翻译。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
      <StackPanel>
        <TextBlock Text="翻译服务" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="API Key" Style="{StaticResource Caption}"/>
        <PasswordBox x:Name="ApiKeyInput" MaxLength="1000"/>
        <TextBlock x:Name="KeyHint" Text="填入密钥，再选择服务或填写接口地址。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,18"/>
        <Grid Margin="0,0,0,15">
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0"><TextBlock Text="API 服务" Style="{StaticResource Caption}"/>
            <Grid><ComboBox x:Name="ProviderCombo" DisplayMemberPath="Name"/>
              <TextBlock x:Name="ProviderPlaceholder" Text="选择服务…" IsHitTestVisible="False" Margin="12,0,25,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="模型" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="ModelInput" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ModelVendorHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,-7,0,10" Visibility="Collapsed"/>
        <Grid Margin="0,-8,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ModelStatus" Text="填入密钥后自动获取，也可直接填写模型 ID。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button x:Name="FetchModels" Grid.Column="1" Content="刷新模型" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,-8,0"/>
          <Button x:Name="TestConnection" Grid.Column="2" Content="测试连接" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="8,0,-8,0"/>
        </Grid>
        <Expander Header="高级选项" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,18">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="思考模式" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="ThinkingModeCombo">
              <ComboBoxItem Content="自动适配（推荐）" Tag="auto"/>
              <ComboBoxItem Content="开启" Tag="enabled"/>
              <ComboBoxItem x:Name="DisableThinkingOption" Content="关闭" Tag="disabled"/>
            </ComboBox>
            <TextBlock x:Name="ThinkingHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,12"/>
            <StackPanel x:Name="ReasoningPanel" Visibility="Collapsed" Margin="0,0,0,12">
              <TextBlock Text="思考强度" Style="{StaticResource Caption}"/>
              <ComboBox x:Name="ReasoningCombo">
                <ComboBoxItem Content="轻量（适合翻译）" Tag="low"/>
                <ComboBoxItem Content="增强" Tag="high"/>
                <ComboBoxItem Content="深度" Tag="max"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="输出 token 上限（选填）" Style="{StaticResource Caption}"/>
            <TextBox x:Name="OutputLimitInput" MaxLength="5"/>
            <TextBlock Text="留空自动适配。包含思考与正文；上限过小可能导致回答被截断，上限不是实际用量。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
          </StackPanel>
        </Expander>
        <Expander x:Name="EndpointExpander" Header="接口地址" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,24">
          <StackPanel Margin="0,12,0,0">
            <TextBox x:Name="EndpointInput" MaxLength="300" FontSize="12"/>
            <TextBlock Text="自定义服务填写兼容接口的基础地址。更改已保存地址需重新填密钥。" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" Foreground="{StaticResource Muted}"/>
            <Button x:Name="DeleteKey" Content="删除此服务的已存密钥" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,8,0,0"/>
          </StackPanel>
        </Expander>
        <TextBlock Text="阅读与翻译" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0"><TextBlock Text="阅读场景" Style="{StaticResource Caption}"/><ComboBox x:Name="SceneCombo"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="目标语言" Style="{StaticResource Caption}"/><TextBox x:Name="TargetInput" MaxLength="40"/></StackPanel>
        </Grid>
        <StackPanel x:Name="SceneDetailPanel" Margin="0,0,0,16" Visibility="Collapsed">
          <TextBlock x:Name="SceneDetailLabel" Text="书名（选填）" Style="{StaticResource Caption}"/>
          <TextBox x:Name="SceneDetailInput" MaxLength="500"/>
        </StackPanel>
        <StackPanel x:Name="GameTypePanel" Margin="0,0,0,16" Visibility="Collapsed">
          <TextBlock Text="游戏文字类型" Style="{StaticResource Caption}"/><ComboBox x:Name="GameTypeCombo"/>
        </StackPanel>
        <TextBlock Text="翻译风格" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="StyleCombo" Margin="0,0,0,28"/>
        <TextBlock Text="展开时，想学什么" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
        <WrapPanel x:Name="LearningChoices" Margin="0,0,0,3"/>
        <Expander Header="添加自己的学习偏好" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,15">
          <StackPanel Margin="0,13,0,0">
            <TextBlock Text="名称" Style="{StaticResource Caption}"/><TextBox x:Name="CustomNameInput" MaxLength="32"/>
            <TextBlock Text="希望怎样讲解" Style="{StaticResource Caption}" Margin="0,12,0,8"/>
            <TextBox x:Name="CustomInstructionInput" AcceptsReturn="True" Height="68" TextWrapping="Wrap" MaxLength="600"/>
            <Button x:Name="AddCustom" Content="添加为可选项" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </Expander>
        <Expander Header="偏好预设" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,28">
          <StackPanel Margin="0,13,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="PresetCombo" DisplayMemberPath="Name"/>
              <Button x:Name="LoadPreset" Content="应用" Grid.Column="1" Margin="8,0,0,0"/>
              <Button x:Name="RemovePreset" Content="删除" Grid.Column="2" Style="{StaticResource GhostButton}" Margin="4,0,0,0"/>
            </Grid>
            <TextBlock Text="把当前场景、语言和学习选项保存为一组。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,9"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PresetNameInput" MaxLength="32"/>
              <Button x:Name="SavePreset" Content="保存预设" Grid.Column="1" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Expander>
        <TextBlock Text="使用习惯" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="ClipboardModeCheck" Content="快捷键读取剪贴板"/>
        <TextBlock Text="开启后先复制，再按快捷键；关闭后尝试读取选区。" Foreground="{StaticResource Muted}" FontSize="11" Margin="25,-5,0,17"/>
        <TextBlock Text="全局快捷键" Style="{StaticResource Caption}"/>
        <TextBox x:Name="ShortcutInput" IsReadOnly="True" IsReadOnlyCaretVisible="False" InputMethod.IsInputMethodEnabled="False" Cursor="Hand" Margin="0,0,0,7" ToolTip="点击后按下快捷键，Esc 取消"/>
        <TextBlock x:Name="ShortcutHint" Text="点击上方，再按下组合键；Esc 取消。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <CheckBox x:Name="AutoStartCheck" Content="开机启动"/>
        <CheckBox x:Name="HistoryCheck" Content="保存本地历史"/>
        <TextBlock Text="关闭保存会清空已有历史。回看不调用 API。" Foreground="{StaticResource Muted}" FontSize="11" Margin="25,-5,0,17"/>
        <TextBlock Text="最多保留条数（20–1000）" Style="{StaticResource Caption}"/>
        <TextBox x:Name="HistoryLimitInput" MaxLength="4" Margin="0,0,0,12"/>
        <TextBlock Text="历史也有存储空间上限；超出后移除最旧记录。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,20"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SettingsStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
        <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="22,10"/>
      </Grid>
    </Border>
  </Grid>
</Window>
