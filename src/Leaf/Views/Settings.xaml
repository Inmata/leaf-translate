<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Leaf · 设置" Width="620" Height="780" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterScreen">
  <Grid Margin="32,26,32,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="按你的习惯翻译。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0"/>
    </StackPanel>
    <ContentControl x:Name="PanelHost" Grid.Row="1"/>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
      <Button x:Name="CloseSettingsButton" Content="完成" Padding="22,10" HorizontalAlignment="Right"/>
    </Border>
  </Grid>
</Window>
